<UserControl x:Class="WPFSample.Timetable.Basic.View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vms="clr-namespace:ViewModelsSamples.Timetable;assembly=ViewModelsSamples"
             xmlns:basic="clr-namespace:ViewModelsSamples.Timetable.Basic;assembly=ViewModelsSamples">
    <UserControl.DataContext>
        <basic:ViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <lvc:CartesianChart Series="{Binding Series}" ZoomMode="Both"/>
    </Grid>
</UserControl>

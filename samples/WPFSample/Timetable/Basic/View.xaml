<UserControl x:Class="WPFSample.Timetable.Basic.View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:basic="clr-namespace:ViewModelsSamples.Timetable.Basic;assembly=ViewModelsSamples">
    <UserControl.DataContext>
        <basic:ViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <lvc:CartesianChart  ZoomMode="Both">
            <lvc:CartesianChart.Series>
                <lvc:SeriesCollection>
                    <lvc:XamlTimetableSeries Values="{Binding Values1}" Rx="10" Ry="10"/>
                    <lvc:XamlTimetableSeries Values="{Binding Values2}" Rx="10" Ry="10"/>
                    <lvc:XamlTimetableSeries Values="{Binding Values3}" Rx="10" Ry="10"/>
                </lvc:SeriesCollection>
            </lvc:CartesianChart.Series>
        </lvc:CartesianChart>
    </Grid>
</UserControl>
